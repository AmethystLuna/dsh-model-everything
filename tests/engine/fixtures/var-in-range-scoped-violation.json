{
  "schemaVersion": 1,
  "init": "A",
  "states": [
    {
      "id": "A"
    },
    {
      "id": "B",
      "terminal": true
    }
  ],
  "transitions": [
    {
      "from": "A",
      "event": "bump",
      "to": "A",
      "updates": [
        {
          "variable": "counter",
          "op": "inc"
        }
      ],
      "guard": {
        "variable": "counter",
        "op": "<",
        "value": 10
      }
    },
    {
      "from": "A",
      "event": "bump",
      "guard": {
        "variable": "counter",
        "op": ">=",
        "value": 10
      },
      "to": "A"
    },
    {
      "from": "A",
      "event": "go",
      "to": "B"
    }
  ],
  "variables": [
    {
      "name": "counter",
      "kind": "integer",
      "init": 0,
      "max": 10
    }
  ],
  "invariants": [
    {
      "id": "counter-small-in-a",
      "description": "counter stays <= 1 while the machine is in A",
      "kind": "var-in-range",
      "variable": "counter",
      "min": 0,
      "max": 1,
      "when": {
        "state": "A"
      }
    }
  ]
}
